# Alfchamps backend configuration
# This is a LOCAL-ONLY tool. Do not expose it beyond localhost.
APP_NAME=Alfchamps
ENVIRONMENT=development

# SQLite database file
DATABASE_URL=sqlite:///./data/alfchamps.db

# Comma-separated list of allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limits
UPLOAD_MAX_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=png,jpg,jpeg,webp,gif
