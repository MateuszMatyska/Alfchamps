# Alfchamps frontend - multi-stage build
# Stage 1 builds the Vite app; Stage 2 serves it with nginx (non-root) and
# proxies API calls to the backend service.

# ---- Stage 1: build ----
FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

COPY frontend/ .
RUN npm run build

# ---- Stage 2: serve ----
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Copy built assets.
COPY --from=build /app/dist /usr/share/nginx/html

# Nginx config that proxies API paths to the backend service.
COPY container/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
